{
  "name": "polski-quest",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:layers": "tsx tools/check_layers.ts",
    "check:banned": "tsx tools/check_banned.ts",
    "test": "vitest run",
    "test:quiet": "PQ_WORKERS=2 taskpolicy -b vitest run",
    "sprites": "python3 tools/sprites_build.py",
    "sprites:check": "python3 tools/sprites_build.py --check",
    "audio": "python3 tools/build_audio.py",
    "audio:check": "python3 tools/build_audio.py --check",
    "check": "npm run typecheck && npm run audio:check && npm run check:layers && npm run check:banned && npm run test && npm run sprites:check && npm run build",
    "check:quiet": "PQ_WORKERS=2 taskpolicy -b npm run check",
    "art": "python3 tools/gen_sprites.py",
    "icons": "python3 tools/gen_icons.py",
    "sobes": "tsx tools/sobes_import.ts",
    "sobes:feed": "tsx tools/sobes_import.ts --feed",
    "words": "python3 tools/words_feed.py",
    "feed:run": "python3 tools/feed_watch.py",
    "feed:install": "python3 tools/feed_install.py install",
    "feed:uninstall": "python3 tools/feed_install.py uninstall",
    "local": "python3 tools/local_deploy.py",
    "local:serve": "python3 tools/local_server.py",
    "local:install": "python3 tools/local_install.py install",
    "local:uninstall": "python3 tools/local_install.py uninstall"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "phaser": "4.2.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
