{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vocab.schema.json",
  "title": "Vocab",
  "description": "content/modules/<id>/vocab.json (ТЗ §3.4). Id глобальные и стабильные: удалять нельзя, только module.renames.",
  "type": "array",
  "items": {
    "title": "VocabEntry",
    "type": "object",
    "required": ["id", "pl", "ru", "pos", "srs"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/lxId" },
      "pl": { "type": "string", "minLength": 1 },
      "ru": { "type": "string", "minLength": 1 },
      "tr": { "type": "string" },
      "pos": { "$ref": "common.schema.json#/$defs/pos" },
      "srs": { "type": "boolean" },
      "cards": { "type": "array", "items": { "enum": ["rec", "lis", "pro"] }, "uniqueItems": true },
      "gender": { "enum": ["m", "f", "n", "mp", "nmp"] },
      "forms": { "type": "object", "additionalProperties": { "type": "string" } },
      "ex": { "$ref": "common.schema.json#/$defs/text2" },
      "ff": {
        "type": "object",
        "required": ["ru", "means"],
        "additionalProperties": false,
        "properties": {
          "ru": { "type": "string" },
          "means": { "type": "string" }
        }
      },
      "clusters": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/cluster" } },
      "tags": { "type": "array", "items": { "type": "string" } },
      "voice": { "type": "string" },
      "legacy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day": { "type": "integer" },
          "trainerId": { "type": "string" }
        }
      }
    }
  }
}
