{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "errorTags.schema.json",
  "title": "ErrorTags",
  "description": "content/errorTags.json: теги ошибок → сцена-лекарство (ТЗ §3.8, §4.4). Префиксы R1..R10, orth.*, gr.*, ff.*, ph.*.",
  "type": "array",
  "items": {
    "title": "ErrorTag",
    "type": "object",
    "required": ["id", "ru"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/errorTag" },
      "ru": { "type": "string", "minLength": 1 },
      "remedy": { "$ref": "common.schema.json#/$defs/id" },
      "cluster": { "$ref": "common.schema.json#/$defs/cluster" }
    }
  }
}
