{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world.schema.json",
  "title": "World",
  "description": "content/world.json: биомы, стадии открытия, старт (ТЗ §3.1).",
  "type": "object",
  "required": ["schema", "start", "maps", "biomes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "start": {
      "type": "object",
      "required": ["location", "spawn"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "common.schema.json#/$defs/id" },
        "spawn": { "type": "string" }
      }
    },
    "maps": {
      "type": "object",
      "required": ["poland", "warszawa"],
      "additionalProperties": false,
      "properties": {
        "poland": { "type": "string" },
        "warszawa": { "type": "string" }
      }
    },
    "biomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Biome",
        "type": "object",
        "required": ["id", "layer", "title", "mapRegion", "locations", "stages"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "layer": { "enum": ["warszawa", "region", "secret"] },
          "title": { "$ref": "common.schema.json#/$defs/text2" },
          "mapRegion": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
          "locations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "border": { "$ref": "common.schema.json#/$defs/id" },
          "modules": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/moduleId" } },
          "hosts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/charId" } },
          "gate": { "$ref": "common.schema.json#/$defs/text2" },
          "stamp": { "type": "string", "pattern": "^stamp\\.[a-z0-9_]+$" },
          "stages": {
            "type": "object",
            "required": ["visible", "preview", "stamp"],
            "additionalProperties": false,
            "properties": {
              "visible": { "$ref": "common.schema.json#/$defs/cond" },
              "preview": { "$ref": "common.schema.json#/$defs/cond" },
              "stamp": { "$ref": "common.schema.json#/$defs/cond" }
            }
          }
        }
      }
    }
  }
}
