{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salad_menu.schema.json",
  "title": "SaladMenu",
  "description": "content/wola/salad/menu.json: меню Salad Story (W-02): салаты, порции, dressingi, палочки, напитки, ингредиенты витрины, свой салат, сезон, написание для озвучки.",
  "type": "object",
  "required": ["schema", "currency", "sizes", "salads", "dressings", "breads", "drinks", "ingredients", "compose", "season", "spoken"],
  "additionalProperties": false,
  "$defs": {
    "menuId": { "title": "MenuId", "type": "string", "pattern": "^m\\.[a-z0-9_]+$" },
    "dressingId": { "title": "DressingId", "type": "string", "pattern": "^d\\.[a-z0-9_]+$" },
    "sprite": { "title": "SpriteFrame", "type": "string", "pattern": "^[a-z0-9_.]+/[0-9]+$", "description": "Кадр атласа custom: `<id спрайта>/<n>`" },
    "extra": {
      "title": "SaladExtra",
      "type": "object",
      "required": ["id", "pl", "ru", "price", "from", "sprite"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/menuId" },
        "pl": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1, "description": "Короткий ответ кассиру (buraczkowy)" },
        "acc": { "type": "string", "minLength": 1, "description": "Винительный после poproszę (wodę)" },
        "ru": { "type": "string", "minLength": 1 },
        "lx": { "$ref": "common.schema.json#/$defs/lxId" },
        "price": { "type": "integer", "minimum": 1 },
        "from": { "type": "integer", "minimum": 1, "maximum": 10 },
        "sprite": { "$ref": "#/$defs/sprite" }
      }
    }
  },
  "properties": {
    "schema": { "const": 1 },
    "note": { "type": "string" },
    "currency": { "const": "zł" },
    "sizes": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "title": "SaladSize",
        "type": "object",
        "required": ["id", "pl", "acc", "ru", "lx", "extra"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["normalna", "powiekszona"] },
          "pl": { "type": "string", "minLength": 1 },
          "acc": { "type": "string", "minLength": 1 },
          "ru": { "type": "string", "minLength": 1 },
          "lx": { "$ref": "common.schema.json#/$defs/lxId" },
          "extra": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "salads": {
      "type": "array", "minItems": 6,
      "items": {
        "title": "SaladDish",
        "type": "object",
        "required": ["id", "name", "ru", "has", "dressing", "price", "from", "sprite"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/menuId" },
          "name": { "type": "string", "minLength": 1, "description": "Название без «Sałatka»: не склоняется (sałatkę Cezar)" },
          "ru": { "type": "string", "minLength": 1 },
          "has": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/lxId" }, "minItems": 1 },
          "dressing": { "$ref": "#/$defs/dressingId" },
          "price": { "type": "integer", "minimum": 1 },
          "from": { "type": "integer", "minimum": 1, "maximum": 10 },
          "season": { "type": "boolean" },
          "sprite": { "$ref": "#/$defs/sprite" }
        }
      }
    },
    "dressings": {
      "type": "array", "minItems": 2,
      "items": {
        "title": "SaladDressing",
        "type": "object",
        "required": ["id", "pl", "ru"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/dressingId" },
          "pl": { "type": "string", "minLength": 1 },
          "ru": { "type": "string", "minLength": 1 },
          "lx": { "$ref": "common.schema.json#/$defs/lxId", "description": "Слово в огороде (jogurtowy); названия-бренды без lx" }
        }
      }
    },
    "breads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/extra" } },
    "drinks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/extra" } },
    "ingredients": {
      "type": "array", "minItems": 3,
      "items": {
        "title": "SaladIngredient",
        "type": "object",
        "required": ["lx", "sprite", "gen"],
        "additionalProperties": false,
        "properties": {
          "lx": { "$ref": "common.schema.json#/$defs/lxId" },
          "sprite": { "$ref": "#/$defs/sprite" },
          "gen": { "type": "string", "minLength": 1, "description": "Родительный (nie ma łososia)" }
        }
      }
    },
    "compose": {
      "title": "SaladCompose",
      "type": "object",
      "required": ["from", "price", "sprite", "slots"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "integer", "minimum": 1, "maximum": 10 },
        "price": { "type": "integer", "minimum": 1 },
        "sprite": { "$ref": "#/$defs/sprite" },
        "slots": {
          "type": "array", "minItems": 1,
          "items": {
            "title": "SaladComposeSlot",
            "type": "object",
            "required": ["id", "ask", "options"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]+$" },
              "ask": { "type": "string", "pattern": "^q\\.[a-z_]+$" },
              "options": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/lxId" }, "minItems": 2 }
            }
          }
        }
      }
    },
    "season": {
      "title": "SaladSeason",
      "type": "object",
      "required": ["from", "salad", "board"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "integer", "minimum": 1, "maximum": 10 },
        "salad": { "$ref": "#/$defs/menuId" },
        "board": { "$ref": "common.schema.json#/$defs/text2" }
      }
    },
    "spoken": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 }, "description": "Заимствование → написание для озвучки (Zosia читает по-польски)" }
  }
}
