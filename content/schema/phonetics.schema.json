{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phonetics.schema.json",
  "title": "Phonetics",
  "description": "content/phonetics.json: кластеры R1–R10, минимальные пары (ТЗ §3.8, §4.3). Пороги статусов в tuning.clusters.",
  "type": "object",
  "required": ["schema", "clusters", "pairs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "clusters": {
      "type": "array",
      "items": {
        "title": "PhoneticCluster",
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/cluster" },
          "title": { "type": "string", "minLength": 1 },
          "repairLesson": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "title": "MinimalPair",
        "type": "object",
        "required": ["id", "a", "b", "cluster"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/mpId" },
          "a": { "type": "string", "minLength": 1 },
          "b": { "type": "string", "minLength": 1 },
          "cluster": { "$ref": "common.schema.json#/$defs/cluster" },
          "ru": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
        }
      }
    }
  }
}
