{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salad_cashiers.schema.json",
  "title": "SaladCashiers",
  "description": "content/wola/salad/cashiers.json: кассиры Salad Story (W-02) и их реплики. ask кассира заменяет common по ключу.",
  "type": "object",
  "required": ["schema", "common", "cashiers"],
  "additionalProperties": false,
  "$defs": {
    "variants": {
      "title": "CashierLines",
      "type": "array", "minItems": 1,
      "items": {
        "title": "CashierLine",
        "type": "object",
        "required": ["pl", "ru"],
        "additionalProperties": false,
        "properties": {
          "pl": { "type": "string", "minLength": 1 },
          "ru": { "type": "string", "minLength": 1 },
          "minLevel": { "type": "integer", "minimum": 1, "maximum": 10 }
        }
      }
    },
    "asks": {
      "title": "CashierAsks",
      "type": "object",
      "propertyNames": { "pattern": "^(q\\.[a-z_]+|[a-z_]+)$" },
      "additionalProperties": { "$ref": "#/$defs/variants" }
    }
  },
  "properties": {
    "schema": { "const": 1 },
    "note": { "type": "string" },
    "common": { "$ref": "#/$defs/asks" },
    "cashiers": {
      "type": "array", "minItems": 2,
      "items": {
        "title": "Cashier",
        "type": "object",
        "required": ["id", "name", "tempo", "sprite", "ask"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/charId" },
          "name": { "type": "string", "minLength": 1 },
          "tempo": { "enum": ["fast", "normal", "slow"] },
          "sprite": { "type": "string", "pattern": "^[a-z0-9_.]+/[0-9]+$" },
          "about": { "type": "string" },
          "ask": { "$ref": "#/$defs/asks" }
        }
      }
    }
  }
}
