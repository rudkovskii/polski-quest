{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conditions.schema.json",
  "title": "Condition",
  "description": "Условие = объект ровно с одним ключом-атомом (ТЗ §3.9).",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 1,
  "additionalProperties": false,
  "properties": {
    "always": { "const": true },
    "all": { "type": "array", "minItems": 1, "items": { "$ref": "#" } },
    "any": { "type": "array", "minItems": 1, "items": { "$ref": "#" } },
    "not": { "$ref": "#" },
    "flag": { "$ref": "common.schema.json#/$defs/id" },
    "item": { "$ref": "common.schema.json#/$defs/itemId" },
    "lessonDone": { "$ref": "common.schema.json#/$defs/id" },
    "bossPassed": { "$ref": "common.schema.json#/$defs/id" },
    "mastery": {
      "type": "object",
      "required": ["module", "level", "min"],
      "additionalProperties": false,
      "properties": {
        "module": { "$ref": "common.schema.json#/$defs/moduleId" },
        "level": { "enum": ["seen", "mastered"] },
        "min": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "cards": {
      "type": "object",
      "required": ["minInterval", "min"],
      "additionalProperties": false,
      "properties": {
        "minInterval": { "type": "integer", "minimum": 0 },
        "min": { "type": "integer", "minimum": 0 }
      }
    },
    "cluster": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/cluster" },
        "status": { "enum": ["green", "yellow", "red", "unknown"] }
      }
    },
    "daysPlayed": { "type": "integer", "minimum": 0 },
    "dateWindow": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
        "to": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" }
      }
    },
    "weekday": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "stage": {
      "type": "object",
      "required": ["biome", "min"],
      "additionalProperties": false,
      "properties": {
        "biome": { "$ref": "common.schema.json#/$defs/id" },
        "min": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "found": { "$ref": "common.schema.json#/$defs/charId" },
    "jars": {
      "type": "object",
      "required": ["min"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "module": { "$ref": "common.schema.json#/$defs/moduleId" },
        "full": { "type": "boolean" }
      }
    },
    "hud": { "$ref": "common.schema.json#/$defs/hud" },
    "daysSinceLast": { "type": "integer", "minimum": 0 },
    "stepDone": { "enum": ["water", "scene", "evening", "sleep"] }
  }
}
