{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tuning.schema.json",
  "title": "Tuning",
  "description": "content/tuning.json: все числа баланса (ТЗ §4.11). Правка баланса без кода; новое число = поле здесь и в tuning.json.",
  "type": "object",
  "required": [
    "schema",
    "dayStartHour",
    "ladder",
    "efMin",
    "efMax",
    "fuzz",
    "newItemsPerDay",
    "maxIntroducesPerLesson",
    "productionAfterReps",
    "obchodBatch",
    "debtLockThreshold",
    "phoneticPerDay",
    "springAfterDays",
    "expressMaxCards",
    "expressMaxMin",
    "sessionTargetMin",
    "sessionSoftCapMin",
    "resumeHours",
    "remedy",
    "clusters",
    "zloty",
    "pierogi",
    "hearts",
    "jars",
    "grade3FastMs",
    "director",
    "orders",
    "kitchen",
    "market",
    "minigames"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "dayStartHour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "ladder": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1
    },
    "efMin": {
      "type": "number",
      "minimum": 1
    },
    "efMax": {
      "type": "number",
      "minimum": 1
    },
    "fuzz": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "newItemsPerDay": {
      "type": "integer",
      "minimum": 0
    },
    "maxIntroducesPerLesson": {
      "type": "integer",
      "minimum": 1
    },
    "productionAfterReps": {
      "type": "integer",
      "minimum": 0
    },
    "obchodBatch": {
      "type": "integer",
      "minimum": 0
    },
    "debtLockThreshold": {
      "type": "integer",
      "minimum": 0
    },
    "phoneticPerDay": {
      "type": "integer",
      "minimum": 0
    },
    "springAfterDays": {
      "type": "integer",
      "minimum": 0
    },
    "expressMaxCards": {
      "type": "integer",
      "minimum": 0
    },
    "expressMaxMin": {
      "type": "integer",
      "minimum": 0
    },
    "sessionTargetMin": {
      "type": "integer",
      "minimum": 0
    },
    "sessionSoftCapMin": {
      "type": "integer",
      "minimum": 0
    },
    "resumeHours": {
      "type": "integer",
      "minimum": 0
    },
    "remedy": {
      "type": "object",
      "required": [
        "errors",
        "windowDays",
        "cooldownDays"
      ],
      "additionalProperties": false,
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "windowDays": {
          "type": "integer",
          "minimum": 0
        },
        "cooldownDays": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clusters": {
      "type": "object",
      "required": [
        "green",
        "yellow",
        "closeScore",
        "closeDays",
        "closeMinAnswers",
        "pairsPerCluster"
      ],
      "additionalProperties": false,
      "properties": {
        "green": {
          "type": "number",
          "minimum": 0
        },
        "yellow": {
          "type": "number",
          "minimum": 0
        },
        "closeScore": {
          "type": "number",
          "minimum": 0
        },
        "closeDays": {
          "type": "integer",
          "minimum": 0
        },
        "closeMinAnswers": {
          "type": "integer",
          "minimum": 0
        },
        "pairsPerCluster": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "zloty": {
      "type": "object",
      "required": [
        "review",
        "newItem",
        "sceneFirst",
        "express",
        "orderBase",
        "orderPerCard",
        "orderMax",
        "bossFirst",
        "dailyCap",
        "hint"
      ],
      "additionalProperties": false,
      "properties": {
        "review": {
          "type": "integer",
          "minimum": 0
        },
        "newItem": {
          "type": "integer",
          "minimum": 0
        },
        "sceneFirst": {
          "type": "integer",
          "minimum": 0
        },
        "express": {
          "type": "integer",
          "minimum": 0
        },
        "orderBase": {
          "type": "integer",
          "minimum": 0
        },
        "orderPerCard": {
          "type": "integer",
          "minimum": 0
        },
        "orderMax": {
          "type": "integer",
          "minimum": 0
        },
        "bossFirst": {
          "type": "integer",
          "minimum": 0
        },
        "dailyCap": {
          "type": "integer",
          "minimum": 0
        },
        "hint": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pierogi": {
      "type": "object",
      "required": [
        "daily",
        "carryMax"
      ],
      "additionalProperties": false,
      "properties": {
        "daily": {
          "type": "integer",
          "minimum": 0
        },
        "carryMax": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hearts": {
      "type": "object",
      "required": [
        "base",
        "perScene",
        "perOrder",
        "max",
        "overdueGraceDays",
        "floor"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "perScene": {
          "type": "number",
          "minimum": 0
        },
        "perOrder": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "overdueGraceDays": {
          "type": "integer",
          "minimum": 0
        },
        "floor": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "jars": {
      "type": "object",
      "required": [
        "thresholds"
      ],
      "additionalProperties": false,
      "properties": {
        "thresholds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3
        }
      }
    },
    "grade3FastMs": {
      "type": "object",
      "required": [
        "choice",
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "choice": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "director": {
      "type": "object",
      "required": [
        "easyWins",
        "more3Min",
        "firstDayRepairIfActiveMinLt"
      ],
      "additionalProperties": false,
      "properties": {
        "easyWins": {
          "type": "integer",
          "minimum": 0
        },
        "more3Min": {
          "type": "integer",
          "minimum": 0
        },
        "firstDayRepairIfActiveMinLt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "orders": {
      "type": "object",
      "required": [
        "perDay",
        "itemsMin",
        "itemsMax",
        "earlyDays",
        "deliveryBonus",
        "stepLimitFactor"
      ],
      "additionalProperties": false,
      "properties": {
        "perDay": {
          "type": "integer",
          "minimum": 0
        },
        "itemsMin": {
          "type": "integer",
          "minimum": 0
        },
        "itemsMax": {
          "type": "integer",
          "minimum": 0
        },
        "earlyDays": {
          "type": "integer",
          "minimum": 0
        },
        "deliveryBonus": {
          "type": "integer",
          "minimum": 0
        },
        "stepLimitFactor": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "kitchen": {
      "type": "object",
      "required": [
        "dailyMax",
        "jarsPerRecipe",
        "bonusItems"
      ],
      "additionalProperties": false,
      "properties": {
        "dailyMax": {
          "type": "integer",
          "minimum": 0
        },
        "jarsPerRecipe": {
          "type": "integer",
          "minimum": 1
        },
        "bonusItems": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "market": {
      "type": "object",
      "required": [
        "enabled",
        "zlPerJar",
        "dailyMax"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "zlPerJar": {
          "type": "integer",
          "minimum": 0
        },
        "dailyMax": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "minigames": {
      "type": "object",
      "required": [
        "fishBiteDelayMs",
        "fishWindowMs",
        "mineFloors"
      ],
      "additionalProperties": false,
      "properties": {
        "fishBiteDelayMs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "fishWindowMs": {
          "type": "integer",
          "minimum": 0
        },
        "mineFloors": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        }
      }
    }
  }
}
