{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "title": "LocationMap",
  "description": "content/modules/<id>/maps/<name>.json: ASCII-локация (ТЗ §3.7). controls обязателен: walk = прямое управление, tap = только тап.",
  "type": "object",
  "required": ["id", "title", "tileset", "controls", "size", "legend", "defaultGround", "layers", "spawns", "objects"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/text2" },
    "tileset": { "enum": ["ninja16", "kenney16", "custom16"] },
    "controls": { "enum": ["walk", "tap"] },
    "size": { "$ref": "common.schema.json#/$defs/xy" },
    "legend": {
      "type": "object",
      "propertyNames": { "minLength": 1, "maxLength": 1 },
      "additionalProperties": {
        "title": "LegendEntry",
        "type": "object",
        "required": ["tile"],
        "additionalProperties": false,
        "properties": {
          "tile": { "type": "string" },
          "solid": { "type": "boolean" },
          "layer": { "enum": ["ground", "deco"] },
          "auto": { "type": "boolean" }
        }
      }
    },
    "defaultGround": { "type": "string", "minLength": 1, "maxLength": 1 },
    "layers": {
      "type": "object",
      "required": ["ground"],
      "additionalProperties": false,
      "properties": {
        "ground": { "type": "array", "items": { "type": "string" } },
        "deco": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spawns": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": { "$ref": "common.schema.json#/$defs/xy" }
    },
    "music": { "type": "string" },
    "objects": {
      "type": "array",
      "items": {
        "title": "MapObject",
        "type": "object",
        "required": ["type"],
        "discriminator": { "propertyName": "type" },
        "oneOf": [
          {
            "title": "MapNpc",
            "type": "object",
            "required": ["type", "id", "at"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "npc" },
              "id": { "$ref": "common.schema.json#/$defs/charId" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "facing": { "enum": ["up", "down", "left", "right"] },
              "if": { "$ref": "common.schema.json#/$defs/cond" }
            }
          },
          {
            "title": "MapExit",
            "type": "object",
            "required": ["type", "at", "to"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "exit" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "to": { "type": "string", "description": "id локации или \"worldmap\"" },
              "spawn": { "type": "string" },
              "if": { "$ref": "common.schema.json#/$defs/cond" }
            }
          },
          {
            "title": "MapTrigger",
            "type": "object",
            "required": ["type", "id", "at", "on", "do"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "trigger" },
              "id": { "type": "string" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "size": { "$ref": "common.schema.json#/$defs/xy" },
              "on": { "enum": ["enter", "tap"] },
              "if": { "$ref": "common.schema.json#/$defs/cond" },
              "do": { "$ref": "common.schema.json#/$defs/effects" },
              "once": { "type": "boolean" }
            }
          },
          {
            "title": "MapPlot",
            "type": "object",
            "required": ["type", "id", "at", "size"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "plot" },
              "id": { "type": "string" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "size": { "$ref": "common.schema.json#/$defs/xy" }
            }
          },
          {
            "title": "MapSign",
            "type": "object",
            "required": ["type", "at", "pl"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "sign" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "pl": { "type": "string" },
              "ru": { "type": "string" },
              "item": { "$ref": "common.schema.json#/$defs/lxId" }
            }
          },
          {
            "title": "MapBoard",
            "type": "object",
            "required": ["type", "at", "board"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "board" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "board": { "enum": ["orders", "kitchen", "spizarnia", "market"] }
            }
          },
          {
            "title": "MapWord",
            "type": "object",
            "required": ["type", "id", "at", "item"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "word" },
              "id": { "type": "string" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "item": { "$ref": "common.schema.json#/$defs/lxId" },
              "ex": { "enum": ["listen", "choice", "type", "dictation", "order"] },
              "sprite": { "type": "string" },
              "if": { "$ref": "common.schema.json#/$defs/cond" }
            }
          },
          {
            "title": "MapSecret",
            "type": "object",
            "required": ["type", "id", "at"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "secret" },
              "id": { "type": "string" },
              "at": { "$ref": "common.schema.json#/$defs/xy" },
              "spot": { "type": "string", "description": "Имя точки для secrets.json; по умолчанию = id" }
            }
          }
        ]
      }
    }
  }
}
