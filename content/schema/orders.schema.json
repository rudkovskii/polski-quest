{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orders.schema.json",
  "title": "Orders",
  "description": "content/orders.json: шаблоны заказов NPC (этап 3, ТЗ §4.13).",
  "type": "array",
  "items": {
    "title": "Order",
    "type": "object",
    "required": ["id", "npc", "frame", "need"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^ord\\.[a-z0-9_]+$" },
      "npc": { "$ref": "common.schema.json#/$defs/charId" },
      "frame": { "$ref": "common.schema.json#/$defs/text2" },
      "need": {
        "type": "object",
        "required": ["count"],
        "additionalProperties": false,
        "properties": {
          "count": { "type": "integer", "minimum": 2, "maximum": 3 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "pos": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/pos" } }
        }
      },
      "build": { "enum": ["words", "phrase"] },
      "phrase": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tiles": { "type": "array", "items": { "type": "string" } },
          "answer": { "type": "array", "items": { "type": "string" } }
        }
      },
      "delivery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "location": { "$ref": "common.schema.json#/$defs/id" },
          "at": { "$ref": "common.schema.json#/$defs/xy" }
        }
      },
      "if": { "$ref": "common.schema.json#/$defs/cond" }
    }
  }
}
