{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module.schema.json",
  "title": "Module",
  "description": "content/modules/<id>/module.json (ТЗ §3.3).",
  "type": "object",
  "required": ["schema", "id", "kind", "status", "title", "lessons", "unlock"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/moduleId" },
    "kind": { "enum": ["chapter", "side", "phonetics", "legacy", "seasonal", "remedy", "mine"] },
    "status": { "enum": ["draft", "ready"] },
    "order": { "type": "integer" },
    "title": { "$ref": "common.schema.json#/$defs/text2" },
    "biome": { "$ref": "common.schema.json#/$defs/id" },
    "teacher": { "$ref": "common.schema.json#/$defs/charId" },
    "cefr": { "enum": ["A0", "A1", "A2"] },
    "canDo": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ru"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "ru": { "type": "string" }
        }
      }
    },
    "unlock": {
      "type": "object",
      "required": ["hard"],
      "additionalProperties": false,
      "properties": {
        "hard": { "$ref": "common.schema.json#/$defs/cond" },
        "soft": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["if", "hint"],
            "additionalProperties": false,
            "properties": {
              "if": { "$ref": "common.schema.json#/$defs/cond" },
              "hint": { "type": "string" }
            }
          }
        }
      }
    },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "boss": { "$ref": "common.schema.json#/$defs/id" },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "ru"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "ru": { "type": "string", "maxLength": 400 },
          "table": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "errorTags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "phonetics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusters": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/cluster" } }
      }
    },
    "srs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "newPerDay": { "type": "integer", "minimum": 1, "maximum": 15 }
      }
    },
    "dateWindow": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
        "to": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" }
      }
    },
    "renames": {
      "description": "Переименование слов: старый lxId → новый lxId (ТЗ §3.0, §3.12).",
      "type": "object",
      "propertyNames": { "pattern": "^lx\\.[a-z0-9_]+$" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/lxId" }
    },
    "onComplete": { "$ref": "common.schema.json#/$defs/effects" }
  }
}
