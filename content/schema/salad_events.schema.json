{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salad_events.schema.json",
  "title": "SaladEvents",
  "description": "content/wola/salad/events.json: гэги ошибок (тег → картинка и реплика кассира) и события визита Salad Story (W-02).",
  "type": "object",
  "required": ["schema", "gags", "events"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "note": { "type": "string" },
    "gags": {
      "type": "array",
      "items": {
        "title": "SaladGag",
        "type": "object",
        "required": ["id", "onTag", "line"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^gag\\.[a-z0-9_]+$" },
          "onTag": { "$ref": "common.schema.json#/$defs/errorTag" },
          "sprite": { "type": "string", "pattern": "^[a-z0-9_.]+/[0-9]+$" },
          "tray": { "enum": ["sok", "xxl", "torba", "dwie"], "description": "Что гэг кладёт на поднос итога" },
          "line": { "$ref": "common.schema.json#/$defs/text2" },
          "title": { "$ref": "common.schema.json#/$defs/text2", "description": "Название в альбоме «Wpadki»" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "title": "SaladEvent",
        "type": "object",
        "required": ["id", "minLevel", "chance"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["ev.co_zwykle", "ev.kasjer_pomylka", "ev.nie_ma", "ev.sezon", "ev.jak_bylo"] },
          "minLevel": { "type": "integer", "minimum": 1, "maximum": 10 },
          "chance": { "type": "number", "minimum": 0, "maximum": 1 },
          "level10Chance": { "type": "number", "minimum": 0, "maximum": 1 },
          "sameOrderLast": { "type": "integer", "minimum": 2 }
        }
      }
    }
  }
}
