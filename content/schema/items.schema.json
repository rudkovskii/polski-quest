{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items.schema.json",
  "title": "Items",
  "description": "content/items.json: только уникальные предметы (билет, ключ), расходников нет (ТЗ §3.8).",
  "type": "array",
  "items": {
    "title": "Item",
    "type": "object",
    "required": ["id", "title", "icon"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/itemId" },
      "title": { "$ref": "common.schema.json#/$defs/text2" },
      "icon": { "type": "string" }
    }
  }
}
