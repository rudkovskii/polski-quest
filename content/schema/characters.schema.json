{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "title": "Characters",
  "description": "content/characters.json: игрок, NPC, компаньон bobr, кот simba (kind: secret), ТЗ §3.2.",
  "type": "array",
  "items": {
    "title": "Character",
    "type": "object",
    "required": ["id", "name", "kind", "addressAs", "voice", "sprite", "portrait"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/charId" },
      "name": { "type": "string", "minLength": 1 },
      "kind": { "enum": ["player", "teacher", "host", "companion", "extra", "secret"] },
      "years": { "type": "string" },
      "status": { "enum": ["ok", "living", "sensitive"], "default": "ok" },
      "addressAs": { "enum": ["ty", "pan", "pani", "panstwo", "none"] },
      "voice": {
        "type": "object",
        "required": ["engine", "id"],
        "additionalProperties": false,
        "properties": {
          "engine": { "enum": ["say", "piper", "none"] },
          "id": { "type": "string" },
          "rate": { "type": "number", "minimum": 0.5, "maximum": 1.5 }
        }
      },
      "sprite": { "type": "string" },
      "portrait": { "type": "string" },
      "traits": { "type": "string", "maxLength": 200 },
      "hearts": { "type": "boolean", "default": true }
    }
  }
}
