{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secrets.schema.json",
  "title": "Secrets",
  "description": "content/secrets.json: кот Симба и другие секреты (ТЗ §3.8). Точки spot объявляются объектами secret в картах. Награда только эффектами, не złoty.",
  "type": "array",
  "items": {
    "title": "Secret",
    "type": "object",
    "required": ["id", "spots", "move", "onFound"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/charId" },
      "spots": {
        "type": "array",
        "minItems": 1,
        "items": {
          "title": "SecretSpot",
          "type": "object",
          "required": ["spot", "location"],
          "additionalProperties": false,
          "properties": {
            "spot": { "type": "string", "minLength": 1 },
            "location": { "$ref": "common.schema.json#/$defs/id" },
            "if": { "$ref": "common.schema.json#/$defs/cond" }
          }
        }
      },
      "move": { "enum": ["daily", "never"] },
      "onFound": { "$ref": "common.schema.json#/$defs/effects" },
      "line": { "$ref": "common.schema.json#/$defs/lineId" }
    }
  }
}
