{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steps.schema.json",
  "title": "Step",
  "description": "Шаг урока (ТЗ §3.5), дискриминатор t. Новый тип = ветка здесь + файл в src/ui/exercises/ + тест.",
  "type": "object",
  "required": [
    "t"
  ],
  "discriminator": {
    "propertyName": "t"
  },
  "oneOf": [
    {
      "title": "StepSay",
      "description": "Реплика NPC",
      "type": "object",
      "required": [
        "t",
        "who",
        "pl"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "say"
        },
        "who": {
          "$ref": "common.schema.json#/$defs/charId"
        },
        "pl": {
          "type": "string",
          "minLength": 1
        },
        "ru": {
          "type": "string"
        },
        "audio": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepExplain",
      "description": "Правило, ≤400 знаков",
      "type": "object",
      "required": [
        "t",
        "md"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "explain"
        },
        "md": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "table": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepShadow",
      "description": "Слушает и повторяет вслух",
      "type": "object",
      "required": [
        "t",
        "pl",
        "repeat"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "shadow"
        },
        "pl": {
          "type": "string",
          "minLength": 1
        },
        "ru": {
          "type": "string"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "slow": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepListen",
      "description": "Слышит фразу, выбирает вариант",
      "type": "object",
      "required": [
        "t",
        "say",
        "options",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "listen"
        },
        "say": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 4
            },
            {
              "type": "string",
              "pattern": "^auto:[a-z0-9_.]+$"
            }
          ]
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "show": {
          "enum": [
            "text",
            "sign"
          ]
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepChoice",
      "description": "Выбор варианта",
      "type": "object",
      "required": [
        "t",
        "q",
        "options",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "choice"
        },
        "q": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 4
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "dir": {
          "enum": [
            "pl-ru",
            "ru-pl"
          ]
        },
        "errorTagByOption": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepOrder",
      "description": "Собирает фразу из плиток",
      "type": "object",
      "required": [
        "t",
        "prompt",
        "tiles",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "order"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "say": {
          "type": "string"
        },
        "tiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "answer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "alt": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepType",
      "description": "Печатает ответ",
      "type": "object",
      "required": [
        "t",
        "prompt",
        "accept"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "type"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "say": {
          "type": "string"
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "lenient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diacritics": {
              "enum": [
                "ok",
                "warn",
                "fail"
              ]
            },
            "ortho": {
              "type": "boolean"
            },
            "typo": {
              "type": "boolean"
            }
          }
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepDictation",
      "description": "Слышит, печатает",
      "type": "object",
      "required": [
        "t",
        "say"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "dictation"
        },
        "say": {
          "type": "string",
          "minLength": 1
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "slowFirst": {
          "type": "boolean"
        },
        "lenient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diacritics": {
              "enum": [
                "ok",
                "warn",
                "fail"
              ]
            },
            "ortho": {
              "type": "boolean"
            },
            "typo": {
              "type": "boolean"
            }
          }
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepMatch",
      "description": "Соединяет пары pl↔ru",
      "type": "object",
      "required": [
        "t",
        "pairs"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "match"
        },
        "pairs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/lxId"
          }
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepGap",
      "description": "Заполняет пропуск ___",
      "type": "object",
      "required": [
        "t",
        "text",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "gap"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 4
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "say": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepMinimalPair",
      "description": "Слышит одно из пары, выбирает",
      "type": "object",
      "required": [
        "t",
        "pair",
        "play",
        "cluster"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "minimal_pair"
        },
        "pair": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "play": {
          "enum": [
            0,
            1,
            "random"
          ]
        },
        "mode": {
          "enum": [
            "which",
            "same_diff"
          ]
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    {
      "title": "StepStress",
      "description": "Тапает ударный слог",
      "type": "object",
      "required": [
        "t",
        "word",
        "syllables",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "stress"
        },
        "word": {
          "type": "string",
          "minLength": 1
        },
        "syllables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "say": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "description": "По умолчанию <lessonId>#<index>"
        },
        "item": {
          "type": "string",
          "pattern": "^(lx|mp)\\.[a-z0-9_]+$",
          "description": "lxId или mpId, которое проверяет шаг"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/errorTag"
          }
        },
        "cluster": {
          "$ref": "common.schema.json#/$defs/cluster"
        },
        "hint": {
          "type": "string"
        }
      }
    }
  ]
}
