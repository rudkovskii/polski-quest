[
  {
    "id": "kazik.water.due",
    "who": "bobr",
    "ru": "Где зарубка, там слово просится. Обойдём и пойдём гулять.",
    "pl": "Zrobiłem znak.",
    "plRu": "Я сделал зарубку."
