[
  {
    "id": "kazik.move.first",
    "who": "bobr",
    "ru": "Стрелки или кружок слева внизу. Подходи к вещам и жми A. Тут каждая табличка что-то говорит.",
    "pl": "Idziemy!",
    "plRu": "Идём!"
  },
  {
    "id": "kazik.water.first",
    "who": "bobr",
    "ru": "Это не огурец, это слово. Подвяло - значит, пора вспомнить. Полей вот это одно.",
    "pl": "Szefie, podlewamy.",
    "plRu": "Шеф, поливаем."
  },
  {
    "id": "kazik.pierogi.first",
    "who": "bobr",
    "ru": "Новые слова как пироги: три в день. Съешь больше, ночью приснятся падежи.",
    "pl": "Trzy pierogi dziennie. Więcej nie zjesz.",
    "plRu": "Три пирога в день. Больше не съешь."
  },
  {
    "id": "sys.kazik.jar.first",
    "who": "bobr",
    "ru": "Это слово ты помнишь уже месяц. Закатываем. Варшава приезжих зовёт słoiki, так что мы с тобой оба банки.",
    "pl": "Dojrzało. Do słoika!",
    "plRu": "Созрело. В банку!"
  },
  {
    "id": "sys.kazik.order.first",
    "who": "bobr",
    "ru": "Банки не для полки. Бася просит три слова. Донеси и собери из них фразу прямо у неё. Zamówienie - заказ. Zakaz - запрет. Перепутаешь, будет запрет на пироги.",
    "pl": "Pani Basia ma zamówienie.",
    "plRu": "У пани Баси заказ."
  },
  {
    "id": "sys.kazik.kitchen.first",
    "who": "bobr",
    "ru": "Хочешь ещё новое слово сегодня? Три старых в кастрюлю. Слова не пропадут, банки вернутся, когда вспомнишь. Раз в день, я не повар.",
    "pl": "Trzy słoiki, jeden pieróg.",
    "plRu": "Три банки - один пирог."
  },
  {
    "id": "sys.kazik.hearts.cool",
    "who": "bobr",
    "ru": "Давно не повторял её слова, она тебя будто не узнаёт. Отнеси заказ, оттает.",
    "pl": "Pani Basia patrzy dziwnie.",
    "plRu": "Пани Бася странно смотрит."
  },
  {
    "id": "kazik.shadow.first",
    "who": "bobr",
    "ru": "Проверять не буду, я не слышу. Скажи вслух, никто не смотрит. Ну, кроме меня.",
    "pl": "Powtórz na głos.",
    "plRu": "Повтори вслух."
  },
  { "id": "ch02.kazik.odwrotnie", "who": "bobr", "pl": "Ja robię odwrotnie.", "plRu": "А я наоборот." },
  {
    "id": "kazik.dream.most",
    "who": "bobr",
    "pl": "Wszystkie bobry budują tamy. Ja buduję most.",
    "plRu": "Все бобры строят плотины. Я строю мост."
  },
  { "id": "kazik.dream.gryze", "who": "bobr", "pl": "Ja nie czytam. Ja gryzę.", "plRu": "Я не читаю. Я грызу." },
  { "id": "intro.kazik.kloda", "who": "bobr", "pl": "Dobra kłoda!", "plRu": "Хорошее бревно!" },
  { "id": "intro.hela.za_darmo", "who": "pani_hela", "pl": "Pan bierze? Za darmo.", "plRu": "Берёте? Даром." },
  { "id": "intro.kazik.gosc_mowi", "who": "bobr", "pl": "No proszę. Gość mówi!", "plRu": "Ну надо же. Гость говорит!" },
  { "id": "intro.kazik.dopiero", "who": "bobr", "pl": "Do widzenia? Dopiero przyszedłeś.", "plRu": "До свидания? Ты только пришёл." },
  {
    "id": "intro.kazik.po_rusku",
    "who": "bobr",
    "ru": "О, ты по-русски? Я с Буга, у нас граница течёт через всё. Kazimierz, для своих Казик. Пошли, покажу участок. Ничей. Теперь наш."
  },
  { "id": "brzechwa.rym_dima", "who": "brzechwa", "pl": "Dima? Rymuje się z „zima”!", "plRu": "Дима? Рифмуется с «зима»!" },
  { "id": "intro.caption.oct", "who": "narrator", "ru": "Октябрь. Варшава. Правый берег." },
  { "id": "intro.caption.bobr", "who": "narrator", "ru": "Бобр. В Варшаве бывает." },
  { "id": "intro.passport.k", "who": "narrator", "pl": "Dla następnego gościa. - K.", "plRu": "Для следующего гостя. - K." },
  { "id": "intro.caption.empty", "who": "narrator", "ru": "Пустой. Почти." },
  { "id": "intro.kazik.dzien_dobry", "who": "bobr", "pl": "Dzień dobry?" },
  { "id": "intro.simba.miau", "who": "simba", "pl": "miau" },
  { "id": "intro.caption.pokazalo", "who": "narrator", "ru": "Показалось." },
  { "id": "sys.jeszcze", "who": "narrator", "pl": "Jeszcze raz.", "plRu": "Ещё раз." },
  { "id": "d02.ui.title", "who": "narrator", "pl": "Dzień 2. Bramka słucha", "plRu": "День 2. Турникет слушает" },
  { "id": "d02.kazik.obchod.1", "who": "bobr", "pl": "Zrobiłem znak.", "plRu": "Я сделал зарубку." },
  { "id": "d02.kazik.obchod.2", "who": "bobr", "ru": "Где зарубка, там слово просится. Обойди и полей." },
  { "id": "d02.kazik.obchod.err", "who": "bobr", "ru": "Ещё зарубка. Завтра спросит снова." },
  { "id": "d02.kazik.obchod.3", "who": "bobr", "pl": "Wszystko podlane.", "plRu": "Всё полито." },
  { "id": "d02.kazik.mail.1", "who": "bobr", "ru": "Почта! Мне никогда не пишут. Читай." },
  { "id": "d02.letter.brzechwa", "who": "narrator", "pl": "Metro Centrum. Bramka. Dziś! J.B.", "plRu": "Метро Centrum. Турникет. Сегодня! Я.Б." },
  { "id": "d02.kazik.mail.2", "who": "bobr", "ru": "Это вчерашний, со шляпой. Метро на том берегу." },
  { "id": "d02.kazik.mail.3", "who": "bobr", "ru": "Пойдём по чужому мосту. Пока по чужому." },
  { "id": "d02.kazik.most.1", "who": "bobr", "pl": "Ładny most. Mój będzie lepszy.", "plRu": "Красивый мост. Мой будет лучше." },
  { "id": "d02.kazik.schody.1", "who": "bobr", "pl": "To nie moje.", "plRu": "Это не моё." },
  { "id": "d02.kazik.schody.2", "who": "bobr", "ru": "У меня лапы с перепонками. Тут кто-то поменьше." },
  { "id": "d02.brzechwa.bramka.1", "who": "brzechwa", "pl": "Cześć, Dima! Zima!", "plRu": "Привет, Дима! Зима!" },
  { "id": "d02.brzechwa.bramka.2", "who": "brzechwa", "pl": "Ta bramka słucha.", "plRu": "Этот турникет слушает." },
  { "id": "d02.kazik.bramka.1", "who": "bobr", "ru": "Пускает тех, кто слышит город. Не экзамен: 12 звуков." },
  { "id": "d02.dima.bramka.start", "who": "dima", "pl": "Słucham!", "plRu": "Слушаю!", "words": ["lx.slucham"] },
  { "id": "d02.bramka.ok", "who": "narrator", "pl": "Pip!", "plRu": "Пип!" },
  { "id": "d02.bramka.err", "who": "narrator", "pl": "Hyk!", "plRu": "Ик!" },
  { "id": "d02.kazik.bramka.mid", "who": "bobr", "ru": "Устал? Кнопка «Wyjdź». Турникет подождёт до завтра." },
  { "id": "d02.brzechwa.bramka.exit", "who": "brzechwa", "pl": "Do jutra! Bramka poczeka.", "plRu": "До завтра! Турникет подождёт." },
  { "id": "d02.brzechwa.result.1", "who": "brzechwa", "pl": "Brawo! Bramka otwarta!", "plRu": "Браво! Турникет открыт!" },
  { "id": "d02.kazik.result.1", "who": "bobr", "ru": "Вот карта звуков. Зелёное держит, красное шатается." },
  { "id": "d02.kazik.result.2", "who": "bobr", "ru": "Красное подлатаем. По кусочку в день, с завтра." },
  { "id": "d02.kazik.result.allgreen", "who": "bobr", "ru": "Всё зелёное? Ты меня пугаешь. Ладно, пойдём быстрее." },
  { "id": "d02.brzechwa.peron.1", "who": "brzechwa", "pl": "Powiesz: „chrząszcz”. Ale nie dziś.", "plRu": "Скажешь: «chrząszcz». Но не сегодня." },
  { "id": "d02.kazik.peron.1", "who": "bobr", "ru": "Это жук. Самое страшное слово. Я его боюсь." },
  { "id": "d02.brzechwa.peron.2", "who": "brzechwa", "pl": "Słuchaj Warszawy! Cześć!", "plRu": "Слушай Варшаву! Пока!" },
  { "id": "d02.kazik.hut.1", "who": "bobr", "ru": "Турникет пустил. Контролёр будет строже. Спим." },
  { "id": "d02.ui.hook", "who": "narrator", "pl": "Jutro: piszesz sam.", "plRu": "Завтра пишешь сам." },
  { "id": "d03.ui.title", "who": "narrator", "pl": "Dzień 3. Ogonek", "plRu": "День 3. Хвостик" },
  { "id": "d03.kazik.obchod.1", "who": "bobr", "ru": "«Dzień dobry» уже крепкое. Сегодня собери его сам, из кусков.", "words": ["lx.dzien_dobry"] },
  { "id": "d03.kazik.obchod.2", "who": "bobr", "ru": "На моём ящике кто-то сидел. Тёплый ещё." },
  { "id": "d03.kazik.obchod.3", "who": "bobr", "pl": "Ktoś tu siedział.", "plRu": "Кто-то тут сидел." },
  { "id": "d03.brzechwa.kiosk.1", "who": "brzechwa", "pl": "Kawa czy woda?", "plRu": "Кофе или вода?", "words": ["lx.kawa","lx.czy_q","lx.woda"] },
  { "id": "d03.kazik.kiosk.1", "who": "bobr", "ru": "Мне «вады»!" },
  { "id": "d03.brzechwa.kiosk.2", "who": "brzechwa", "pl": "Nie „wada”. Wo-da!", "plRu": "Не «вада». Во-да!" },
  { "id": "d03.kazik.kiosk.2", "who": "bobr", "ru": "«Wada» у них «недостаток». Понял. Молчу." },
  { "id": "d03.brzechwa.kiosk.err", "who": "brzechwa", "pl": "Ta-TA? Nie. TA-ta!", "plRu": "Та-ТА? Нет. ТА-та!" },
  { "id": "d03.dima.kiosk.1", "who": "dima", "pl": "Woda, proszę.", "plRu": "Воду, пожалуйста.", "words": ["lx.woda","lx.prosze"] },
  { "id": "d03.brzechwa.kiosk.3", "who": "brzechwa", "pl": "Proszę!", "plRu": "Пожалуйста!", "words": ["lx.prosze"] },
  { "id": "d03.kazik.kiosk.3", "who": "bobr", "ru": "Хорошая вода. Речная лучше." },
  { "id": "d03.kazik.evening.1", "who": "bobr", "ru": "Первая свая. Стоит! Нужна табличка." },
  { "id": "d03.kazik.evening.2", "who": "bobr", "ru": "Напиши «Proszę». Мост для всех: проходите, прошу.", "words": ["lx.prosze"] },
  { "id": "d03.kazik.keyboard.1", "who": "bobr", "pl": "Ogonek. Jak u mnie.", "plRu": "Хвостик. Как у меня." },
  { "id": "d03.kazik.keyboard.2", "who": "bobr", "ru": "У тебя нет польских букв, у меня нет пальцев. Буквы сверху." },
  { "id": "d03.kazik.keyboard.3", "who": "bobr", "ru": "В конце ę с хвостиком. Хвостик зовут ogonek." },
  { "id": "d03.kazik.evening.3", "who": "bobr", "pl": "Proszę! Dobra tabliczka.", "plRu": "Прошу! Хорошая табличка." },
  { "id": "d03.kazik.hut.1", "who": "bobr", "ru": "Первая свая с табличкой. Мосту три дня, а уже вежливый." },
  { "id": "d03.ui.hook", "who": "narrator", "pl": "Jutro: powtórz!", "plRu": "Завтра: повтори!" },
  { "id": "idle.kazik.1", "who": "bobr", "pl": "Kłoda!", "plRu": "Бревно!" },
  { "id": "idle.kazik.2", "who": "bobr", "ru": "Я не ворчу. Я прорабствую." },
  { "id": "idle.kazik.3", "who": "bobr", "pl": "Spoko. Most stoi.", "plRu": "Спокойно. Мост стоит." },
  { "id": "idle.brzechwa.1", "who": "brzechwa", "pl": "Słuchaj Warszawy.", "plRu": "Слушай Варшаву." },
  { "id": "idle.brzechwa.2", "who": "brzechwa", "pl": "Kawa, trawa, Warszawa!", "plRu": "Кофе, трава, Варшава!" },
  { "id": "idle.brzechwa.3", "who": "brzechwa", "pl": "Powtórz! Ach, nic nie mówiłeś.", "plRu": "Повтори! А, ты ничего не говорил." },
  { "id": "idle.marek.1", "who": "pan_marek", "pl": "Już, już!", "plRu": "Сейчас-сейчас!" },
  { "id": "idle.marek.2", "who": "pan_marek", "pl": "Kawa? Herbata? Już!", "plRu": "Кофе? Чай? Сейчас!" },
  { "id": "idle.marek.3", "who": "pan_marek", "pl": "Poniedziałek...", "plRu": "Понедельник..." },
  { "id": "idle.pasazer.1", "who": "pasazer", "pl": "Nie szkodzi.", "plRu": "Ничего страшного." },
  { "id": "idle.pasazer.2", "who": "pasazer", "pl": "Bóbr w metrze? Warszawa...", "plRu": "Бобр в метро? Варшава..." },
  { "id": "idle.basia.1", "who": "pani_basia", "pl": "Zawsze jest miejsce dla gościa.", "plRu": "Для гостя всегда есть место." },
  { "id": "idle.basia.2", "who": "pani_basia", "pl": "Kolano? Tak sobie.", "plRu": "Колено? Так себе." },
  { "id": "idle.basia.3", "who": "pani_basia", "pl": "Krówkę? Proszę.", "plRu": "Конфетку? Пожалуйста." },
  { "id": "idle.ola.1", "who": "ola", "pl": "Hej! Uwaga, drzwi!", "plRu": "Привет! Осторожно, двери!" },
  { "id": "idle.ola.2", "who": "ola", "pl": "Cześć, Dima! Co słychać?", "plRu": "Привет, Дима! Как дела?" },
  { "id": "idle.kasia.1", "who": "kasia", "pl": "Cześć! Jestem z Krakowa.", "plRu": "Привет! Я из Кракова." },
  { "id": "idle.kasia.2", "who": "kasia", "pl": "Warszawa? Spoko. Kraków lepszy.", "plRu": "Варшава? Нормально. Краков лучше." },
  { "id": "idle.urzedniczka.1", "who": "urzedniczka", "pl": "Numerek, proszę.", "plRu": "Номерок, пожалуйста." },
  { "id": "idle.urzedniczka.2", "who": "urzedniczka", "pl": "Następny!", "plRu": "Следующий!" },
  { "id": "idle.konduktor.1", "who": "konduktor", "pl": "Bilet jest? Dobrze.", "plRu": "Билет есть? Хорошо." },
  { "id": "idle.konduktor.2", "who": "konduktor", "pl": "Kontrola będzie. Kiedyś.", "plRu": "Проверка будет. Когда-нибудь." },
  { "id": "d04.ui.title", "who": "narrator", "pl": "Dzień 4. Powtórz!", "plRu": "День 4. Повтори!" },
  { "id": "d04.marek.cart.1", "who": "pan_marek", "pl": "Już, już!", "plRu": "Сейчас-сейчас!" },
  { "id": "d04.kazik.cart.1", "who": "bobr", "ru": "Хочу чай. Чай тут «herbata». Не спрашивай почему.", "words": ["lx.herbata"] },
  { "id": "d04.marek.cart.2", "who": "pan_marek", "pl": "Słucham?", "plRu": "Слушаю?", "words": ["lx.slucham"] },
  { "id": "d04.kazik.cart.2", "who": "bobr", "ru": "«Słucham» тут не «слушаю тебя», а «что желаете».", "words": ["lx.slucham"] },
  { "id": "d04.marek.cart.3", "who": "pan_marek", "pl": "Dziesięć złotych.", "plRu": "Десять злотых." },
  { "id": "d04.marek.cart.err", "who": "pan_marek", "pl": "Siano? Nie mamy siana.", "plRu": "Сено? Сена у нас нет." },
  { "id": "d04.brzechwa.cart.1", "who": "brzechwa", "pl": "Mała kawa! Powtórz!", "plRu": "Маленький кофе! Повтори!" },
  { "id": "d04.kazik.shadow.1", "who": "bobr", "pl": "Powtórz na głos.", "plRu": "Повтори вслух." },
  { "id": "d04.kazik.shadow.2", "who": "bobr", "ru": "Проверять не буду. Скажи вслух, никто не смотрит. Кроме меня." },
  { "id": "d04.marek.simba", "who": "pan_marek", "pl": "Kot? Nie ma kota.", "plRu": "Кот? Нет кота." },
  { "id": "d04.ui.hook", "who": "narrator", "pl": "Jutro: kłoda w metrze.", "plRu": "Завтра: бревно в метро." },
  { "id": "d05.ui.title", "who": "narrator", "pl": "Dzień 5. Przepraszam", "plRu": "День 5. Извините", "words": ["lx.dzien","lx.przepraszam"] },
  { "id": "d05.kazik.wagon.1", "who": "bobr", "ru": "Нашёл бревно на том берегу. Везём домой. На метро." },
  { "id": "d05.pasazer.1", "who": "pasazer", "pl": "Au!", "plRu": "Ай!" },
  { "id": "d05.kazik.wagon.2", "who": "bobr", "ru": "Это бревно. То есть я. Скажи ему «извините»." },
  { "id": "d05.pasazer.2", "who": "pasazer", "pl": "Nie szkodzi.", "plRu": "Ничего страшного." },
  { "id": "d05.pasazer.err", "who": "pasazer", "pl": "Proszę? Co „proszę”?", "plRu": "Пожалуйста? Что «пожалуйста»?" },
  { "id": "d05.kazik.evening.1", "who": "bobr", "ru": "Вечер. Вода говорит. Лови слова, которые шатаются." },
  { "id": "d05.kazik.evening.2", "who": "bobr", "pl": "Ryba? Nie. Słowo.", "plRu": "Рыба? Нет. Слово." },
  { "id": "d05.kazik.simba", "who": "bobr", "ru": "Кто съел рыбу? Не смотри так. Бобры не едят рыбу." },
  { "id": "d05.ui.hook", "who": "narrator", "pl": "Jutro: kasza czy ciasto?", "plRu": "Завтра: каша или пирог?" },
  { "id": "d06.ui.title", "who": "narrator", "pl": "Dzień 6. Kasza czy ciasto?", "plRu": "День 6. Каша или пирог?", "words": ["lx.dzien","lx.kasza","lx.czy_q","lx.ciasto"] },
  { "id": "d06.brzechwa.1", "who": "brzechwa", "pl": "Albo „cześć”, albo „dzień dobry”!", "plRu": "Либо «привет», либо «добрый день»!" },
  { "id": "d06.kazik.cart.1", "who": "bobr", "ru": "Хочу пирог. Ciasto. С «чь». Не перепутай с kasza.", "words": ["lx.ciasto","lx.kasza"] },
  { "id": "d06.marek.1", "who": "pan_marek", "pl": "Kasza czy ciasto?", "plRu": "Каша или пирог?", "words": ["lx.kasza","lx.czy_q","lx.ciasto"] },
  { "id": "d06.marek.2", "who": "pan_marek", "pl": "Ciasto! Już, już!", "plRu": "Пирог! Сейчас-сейчас!" },
  { "id": "d06.kazik.cart.2", "who": "bobr", "pl": "Ciasto!", "plRu": "Пирог!", "words": ["lx.ciasto"] },
  { "id": "d06.marek.err", "who": "pan_marek", "pl": "Kasza. Smacznego!", "plRu": "Каша. Приятного аппетита!" },
  { "id": "d06.kazik.evening.1", "who": "bobr", "ru": "Сегодня сам решай. Рыбалка или табличка?" },
  { "id": "d06.dima.evening.a", "who": "dima", "pl": "Ryby", "plRu": "Рыбалка" },
  { "id": "d06.dima.evening.b", "who": "dima", "pl": "Tabliczka", "plRu": "Табличка" },
  { "id": "d06.kazik.simba", "who": "bobr", "pl": "To nie moje.", "plRu": "Это не моё." },
  { "id": "d06.ui.hook", "who": "narrator", "pl": "Jutro: zaraz wracam.", "plRu": "Завтра: сейчас вернусь." },
  { "id": "d07.ui.title", "who": "narrator", "pl": "Dzień 7. Zaraz wracam", "plRu": "День 7. Сейчас вернусь" },
  { "id": "d07.kazik.morning.1", "who": "bobr", "ru": "Сегодня полегче. Польём, и свободен." },
  { "id": "d07.kazik.express.1", "who": "bobr", "pl": "Szybko? Trzy minuty.", "plRu": "Быстро? Три минуты." },
  { "id": "d07.kazik.express.2", "who": "bobr", "ru": "Мало времени, жми «Ekspres»: только то, что горит." },
  { "id": "d07.kazik.zaraz", "who": "bobr", "ru": "«Zaraz wracam» висит с понедельника. Кто-то спит на прилавке." },
  { "id": "d07.kazik.k.1", "who": "bobr", "ru": "Прочитай ещё раз записку. Там, где «K.»." },
  { "id": "d07.passport.note", "who": "narrator", "pl": "Dla następnego gościa. - K.", "plRu": "Для следующего гостя. - K." },
  { "id": "d07.kazik.k.2", "who": "bobr", "ru": "«Следующего». Значит, был и предыдущий. Кто?" },
  { "id": "d07.ui.hook", "who": "narrator", "pl": "Jutro: ciężkie torby.", "plRu": "Завтра: тяжёлые сумки." },
  { "id": "d08.ui.title", "who": "narrator", "pl": "Dzień 8. Proszę bardzo", "plRu": "День 8. Пожалуйста" },
  { "id": "d08.basia.stairs.1", "who": "pani_basia", "pl": "Ojej... Ciężkie.", "plRu": "Ой-ой... Тяжело." },
  { "id": "d08.kazik.stairs.1", "who": "bobr", "ru": "Помоги пани. Я бы сам, но я ростом с сумку." },
  { "id": "d08.basia.stairs.2", "who": "pani_basia", "pl": "Dziękuję! Krówkę?", "plRu": "Спасибо! Конфетку?" },
  { "id": "d08.basia.stairs.3", "who": "pani_basia", "pl": "Proszę bardzo!", "plRu": "Пожалуйста!" },
  { "id": "d08.basia.err", "who": "pani_basia", "pl": "Ręka! Moja ręka!", "plRu": "Рука! Моя рука!" },
  { "id": "d08.basia.dzialka", "who": "pani_basia", "pl": "Pan mieszka na działce? Ciekawe...", "plRu": "Вы живёте на участке? Интересно..." },
  { "id": "d08.basia.simba", "who": "pani_basia", "pl": "To nie mój kot.", "plRu": "Это не мой кот." },
  { "id": "d08.kazik.reallife.1", "who": "bobr", "pl": "Powiedz to w Żabce.", "plRu": "Скажи это в Жабке." },
  { "id": "d08.kazik.reallife.2", "who": "bobr", "ru": "Задание со звёздочкой: скажи «dziękuję» вживую. Я поверю.", "words": ["lx.dziekuje"] },
  { "id": "d08.ui.hook", "who": "narrator", "pl": "Jutro: siostra.", "plRu": "Завтра: сестра." },
  { "id": "d09.ui.title", "who": "narrator", "pl": "Dzień 9. To moja siostra", "plRu": "День 9. Это моя сестра" },
  { "id": "d09.ola.1", "who": "ola", "pl": "Cześć! Jestem Ola.", "plRu": "Привет! Я Оля." },
  { "id": "d09.ola.2", "who": "ola", "pl": "To moja siostra, Kasia.", "plRu": "Это моя сестра, Кася." },
  { "id": "d09.kasia.1", "who": "kasia", "pl": "Cześć! Jestem z Krakowa.", "plRu": "Привет! Я из Кракова." },
  { "id": "d09.kazik.1", "who": "bobr", "ru": "Kasia, не kasza. Запомнил с первого раза. Почти.", "words": ["lx.kasia","lx.kasza"] },
  { "id": "d09.kasia.err", "who": "kasia", "pl": "Ka-si-a? Nie. Ka-sia!", "plRu": "Ка-си-а? Нет. Ка-ся!" },
  { "id": "d09.kasia.2", "who": "kasia", "pl": "Warszawa? Spoko. Ale Kraków...", "plRu": "Варшава? Нормально. Но Краков..." },
  { "id": "d09.kazik.2", "who": "bobr", "ru": "Начинается. Тут каждый уверен, что настоящая Польша у него." },
  { "id": "d09.ola.simba", "who": "ola", "pl": "Był tu jakiś kot.", "plRu": "Тут был какой-то кот." },
  { "id": "d09.ui.hook", "who": "narrator", "pl": "Jutro: gdzie wysiadamy?", "plRu": "Завтра: где выходим?" },
  { "id": "d10.ui.title", "who": "narrator", "pl": "Dzień 10. Ja wysiadam", "plRu": "День 10. Я выхожу" },
  { "id": "d10.announce.1", "who": "narrator", "pl": "Następna stacja: Świętokrzyska.", "plRu": "Следующая станция: Świętokrzyska." },
  { "id": "d10.kazik.1", "who": "bobr", "ru": "Щвен... Щвенто... Не выговорю. Выхожу." },
  { "id": "d10.kazik.2", "who": "bobr", "pl": "Ja wysiadam.", "plRu": "Я выхожу." },
  { "id": "d10.brzechwa.1", "who": "brzechwa", "pl": "Po sylabach! Świę-to-krzy-ska.", "plRu": "По слогам! Świę-to-krzy-ska." },
  { "id": "d10.kazik.err", "who": "bobr", "ru": "Двери закрылись. Я ещё круг сделаю." },
  { "id": "d10.brzechwa.k.1", "who": "brzechwa", "pl": "Pokaż paszport.", "plRu": "Покажи паспорт." },
  { "id": "d10.brzechwa.k.2", "who": "brzechwa", "pl": "Podpis: „K.”. Autor nieznany.", "plRu": "Подпись: «K.». Автор неизвестен." },
  { "id": "d10.brzechwa.k.3", "who": "brzechwa", "pl": "Jestem adwokatem. To ciekawe.", "plRu": "Я адвокат. Это интересно." },
  { "id": "d10.kazik.k.1", "who": "bobr", "ru": "Он адвокат по авторским правам. Даже записку проверил." },
  { "id": "d10.kazik.simba", "who": "bobr", "ru": "Слышал «мяу» в туннеле? Эхо. Наверное." },
  { "id": "d10.ui.hook", "who": "narrator", "pl": "Jutro: rz czy ż?", "plRu": "Завтра: rz или ż?" },
  { "id": "d11.ui.title", "who": "narrator", "pl": "Dzień 11. Morze czy może?", "plRu": "День 11. Море или может?", "words": ["lx.dzien","lx.morze","lx.czy_q","lx.moze"] },
  { "id": "d11.brzechwa.1", "who": "brzechwa", "pl": "„Morze”: rz czy ż?", "plRu": "«Morze» (море): rz или ż?" },
  { "id": "d11.kazik.morze.1", "who": "bobr", "pl": "Rz. Jak rzeka. Ja tam mieszkam.", "plRu": "Rz. Как река. Я там живу." },
  { "id": "d11.brzechwa.2", "who": "brzechwa", "pl": "Brawo! A „może”?", "plRu": "Браво! А «może» (может)?" },
  { "id": "d11.brzechwa.err", "who": "brzechwa", "pl": "Może morze? Może!", "plRu": "Может, море? Может!", "words": ["lx.moze","lx.morze"] },
  { "id": "d11.brzechwa.bobr.1", "who": "brzechwa", "pl": "Bóbr. „Ó” z kreską!", "plRu": "Бобр. «Ó» с чёрточкой!" },
  { "id": "d11.kazik.bobr.1", "who": "bobr", "ru": "Я знаю, как я пишусь." },
  { "id": "d11.brzechwa.bobr.2", "who": "brzechwa", "pl": "Bóbr... bóbr... Nic się nie rymuje.", "plRu": "Бобр... бобр... Ничего не рифмуется." },
  { "id": "d11.kazik.simba", "who": "bobr", "ru": "Следы на песке. До забора и всё. Перелезли. Нахально." },
  { "id": "d11.ui.hook", "who": "narrator", "pl": "Jutro: czytamy Warszawę.", "plRu": "Завтра: читаем Варшаву." },
  { "id": "d12.ui.title", "who": "narrator", "pl": "Dzień 12. Czytamy Warszawę", "plRu": "День 12. Читаем Варшаву" },
  { "id": "d12.kazik.1", "who": "bobr", "ru": "Сегодня ты читаешь за двоих. Я грызу за двоих." },
  { "id": "d12.kazik.pchac", "who": "bobr", "pl": "Pchać. Jak tamę.", "plRu": "Толкать. Как плотину." },
  { "id": "d12.kazik.sklep", "who": "bobr", "ru": "«Sklep» это магазин. Не склеп. Хотя в понедельник похоже.", "words": ["lx.sklep"] },
  { "id": "d12.kazik.simba.1", "who": "bobr", "pl": "Kot. Jakiś kot. Nie interesuje mnie.", "plRu": "Кот. Какой-то кот. Меня не интересует." },
  { "id": "d12.brzechwa.polska.1", "who": "brzechwa", "pl": "Prawdziwa Polska? Tam, gdzie mówią „chrząszcz”!", "plRu": "Настоящая Польша? Там, где говорят «chrząszcz»!" },
  { "id": "d12.ui.hook", "who": "narrator", "pl": "Jutro: numerek.", "plRu": "Завтра: номерок." },
  { "id": "d13.ui.title", "who": "narrator", "pl": "Dzień 13. Numerek 147", "plRu": "День 13. Номерок 147" },
  { "id": "d13.sign.numerek", "who": "narrator", "pl": "Numerek: 147. Obsługujemy: 12.", "plRu": "Номерок: 147. Обслуживаем: 12." },
  { "id": "d13.kazik.numerek.1", "who": "bobr", "ru": "Сто сорок седьмой. Успеем построить ещё один мост." },
  { "id": "d13.urzedniczka.1", "who": "urzedniczka", "pl": "Następny! Imię?", "plRu": "Следующий! Имя?" },
  { "id": "d13.urzedniczka.2", "who": "urzedniczka", "pl": "Proszę przeliterować.", "plRu": "Продиктуйте по буквам.", "words": ["lx.prosze_przeliterowac"] },
  { "id": "d13.kazik.bilet", "who": "bobr", "ru": "Мне тоже билет. Я пассажир. Фамилия Bóbr." },
  { "id": "d13.urzedniczka.err", "who": "urzedniczka", "pl": "Bubr?", "plRu": "Бубр?" },
  { "id": "d13.urzedniczka.3", "who": "urzedniczka", "pl": "Bilet tymczasowy. Proszę.", "plRu": "Временный билет. Пожалуйста." },
  { "id": "d13.konduktor.1", "who": "konduktor", "pl": "Jutro sprawdzę.", "plRu": "Завтра проверю." },
  { "id": "d13.kazik.simba", "who": "bobr", "ru": "На номерке лапа. Кто-то стоял в очереди до нас." },
  { "id": "d13.ui.hook", "who": "narrator", "pl": "Jutro: bilety do kontroli!", "plRu": "Завтра: билеты к проверке!" },
  { "id": "d14.ui.title", "who": "narrator", "pl": "Dzień 14. Bilety do kontroli!", "plRu": "День 14. Билеты к проверке!" },
  { "id": "d14.kazik.morning.1", "who": "bobr", "ru": "Сегодня контролёр. Всё это ты уже слышал. Просто едем." },
  { "id": "d14.konduktor.1", "who": "konduktor", "pl": "Bilety do kontroli!", "plRu": "Билеты к проверке!" },
  { "id": "d14.konduktor.err", "who": "konduktor", "pl": "Proszę powtórzyć?", "plRu": "Повторите, пожалуйста?", "words": ["lx.prosze_powtorzyc"] },
  { "id": "d14.konduktor.2", "who": "konduktor", "pl": "W porządku. Bilet miesięczny.", "plRu": "Всё в порядке. Проездной на месяц." },
  { "id": "d14.konduktor.3", "who": "konduktor", "pl": "I pieczątka: Praga.", "plRu": "И печать: Прага." },
  { "id": "d14.konduktor.4", "who": "konduktor", "pl": "Ta stara pieczątka... Takich już nie ma.", "plRu": "Эта старая печать... Таких уже нет." },
  { "id": "d14.kazik.stamp.1", "who": "bobr", "pl": "Pieczątka!", "plRu": "Печать!" },
  { "id": "d14.kazik.stamp.2", "who": "bobr", "ru": "Прага говорит: с тобой можно разговаривать. Не отнимут." },
  { "id": "d14.brzechwa.1", "who": "brzechwa", "pl": "A teraz: „chrząszcz”!", "plRu": "А теперь: «chrząszcz»!" },
  { "id": "d14.brzechwa.2", "who": "brzechwa", "pl": "Brawo! Słyszysz Warszawę.", "plRu": "Браво! Ты слышишь Варшаву." },
  { "id": "d14.kazik.map.1", "who": "bobr", "pl": "Tam jest mgła.", "plRu": "Там туман." },
  { "id": "d14.kazik.map.2", "who": "bobr", "ru": "Туман не запрет. Мы пока не понимаем, что там говорят." },
  { "id": "d14.kazik.bridge.1", "who": "bobr", "pl": "No to budujemy.", "plRu": "Ну, строим." },
  { "id": "d14.kazik.bridge.2", "who": "bobr", "ru": "Первый пролёт. Я дерево, ты слова." },
  { "id": "d14.letter.chopin", "who": "narrator", "pl": "Panie Dimo, zapraszam na Rynek. F.C.", "plRu": "Пан Дима, приглашаю на Рынок. Ф.Ш." },
  { "id": "d14.kazik.letter", "who": "bobr", "ru": "Ещё один на букву. Не на K, уже легче." },
  { "id": "d14.ui.hook", "who": "narrator", "pl": "Jutro: Stare Miasto.", "plRu": "Завтра: Старый город." },
  { "id": "sys.kazik.prawie", "who": "bobr", "pl": "Prawie. Jeszcze raz.", "plRu": "Почти. Ещё раз." },
  { "id": "sys.kazik.obchod", "who": "bobr", "pl": "Zrobiłem znak.", "plRu": "Я сделал зарубку." },
  { "id": "sys.kazik.sleep", "who": "bobr", "pl": "Idziemy spać. Jutro też jest dzień.", "plRu": "Идём спать. Завтра тоже день." },
  { "id": "sys.kazik.done", "who": "bobr", "pl": "Do jutra!", "plRu": "До завтра!" },
  { "id": "sys.kazik.done.2", "who": "bobr", "ru": "На сегодня всё. Завтра польём. Хочешь ещё, жми «+3 минуты»." },
  { "id": "sys.kazik.evening", "who": "bobr", "pl": "Wieczór.", "plRu": "Вечер." },
  { "id": "sys.kazik.express", "who": "bobr", "pl": "Szybko? Trzy minuty.", "plRu": "Быстро? Три минуты." },
  { "id": "sys.kazik.resume", "who": "bobr", "pl": "Gdzie byliśmy?", "plRu": "Где мы были?" },
  { "id": "sys.kazik.resume.2", "who": "bobr", "ru": "Ушёл посреди фразы. Бревно лежит, где лежало." },
  { "id": "sys.kazik.return", "who": "bobr", "pl": "Wróciłeś! Wiosna.", "plRu": "Вернулся! Весна." },
  { "id": "sys.kazik.return.2", "who": "bobr", "ru": "Всё заросло. Не страшно. Пять лёгких для разминки." },
  { "id": "sys.kazik.jam", "who": "bobr", "pl": "Zator.", "plRu": "Затор." },
  { "id": "sys.kazik.jam.2", "who": "bobr", "ru": "Брёвна сбились. Новое подождёт, разберём по 15. Никто не виноват." },
  { "id": "sys.kazik.repair", "who": "bobr", "pl": "Ten kawałek się chwieje.", "plRu": "Этот кусок шатается." },
  { "id": "sys.kazik.repair.2", "who": "bobr", "ru": "Три раза споткнулся на одном. Две минуты, подобьём, как сваю." },
  { "id": "sys.kazik.reallife", "who": "bobr", "pl": "Powiedz to w Żabce.", "plRu": "Скажи это в Жабке." },
  { "id": "sys.kazik.sunday.1", "who": "bobr", "pl": "Niedziela. Sklepy zamknięte.", "plRu": "Воскресенье. Магазины закрыты." },
  { "id": "sys.kazik.sunday.2", "who": "bobr", "ru": "Сегодня только полив. Żabka открыта, но мы отдыхаем.", "words": ["lx.zabka"] },
  { "id": "sys.kazik.bridge.span", "who": "bobr", "pl": "No to budujemy.", "plRu": "Ну, строим." },
  { "id": "sys.kazik.extra_repair", "who": "bobr", "ru": "Ещё одна свая. Быстро." },
  { "id": "d02.brzechwa.bramka.2.mute", "who": "brzechwa", "pl": "Ta bramka czyta.", "plRu": "Этот турникет читает." },
  { "id": "d02.kazik.bramka.1.mute", "who": "bobr", "ru": "Без звука он читает. Покажет звук буквами, выбери, как пишется." },
  { "id": "d04.kazik.shadow.2.mute", "who": "bobr", "ru": "Без звука? Скажи про себя, губами. Я всё равно не проверяю." },
  { "id": "d05.kazik.evening.1.mute", "who": "bobr", "ru": "Вечер. Ловим буквы. Та же вода, другие рыбы." },
  { "id": "d10.announce.1.mute", "who": "narrator", "pl": "NASTĘPNA STACJA: ŚWIĘTOKRZYSKA", "plRu": "Следующая станция" },
  { "id": "d14.brzechwa.2.mute", "who": "brzechwa", "pl": "Brawo! Czytasz Warszawę.", "plRu": "Браво! Ты читаешь Варшаву." },
  { "id": "d14.konduktor.mute", "who": "konduktor", "pl": "Proszę przeczytać.", "plRu": "Прочитайте, пожалуйста." }
]
